# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Template for Binance Futures Testnet credentials
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file to .env  →  cp .env.example .env
# 2. Replace the placeholder values with your actual testnet API keys.
# 3. Get testnet keys at: https://testnet.binancefuture.com
# 4. NEVER commit .env to version control!
# ─────────────────────────────────────────────────────────────────────────────

BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_API_SECRET=your_testnet_api_secret_here
