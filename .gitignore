# ─────────────────────────────────────────────────────────────────────────────
# .gitignore — Binance Futures Trading Bot
# ─────────────────────────────────────────────────────────────────────────────

# ── Credentials (NEVER commit real API keys) ──────────────────────────────────
.env

# ── Python cache & bytecode ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
env/
.venv/
.env/
ENV/

# ── Distribution / packaging ──────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg

# ── Log files (optional: keep sample logs, ignore large ones) ─────────────────
# logs/*.log        # Uncomment to ignore ALL log files
logs/bot.log.*     # Ignore rotated log backups (bot.log.1, bot.log.2, …)

# ── IDE / editor files ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Testing / coverage ────────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
*.cover

# ── Jupyter (if used for analysis) ───────────────────────────────────────────
.ipynb_checkpoints/
